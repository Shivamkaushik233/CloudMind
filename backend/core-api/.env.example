DATABASE_URL=sqlite:///./cloudmind.db
# PostgreSQL: postgresql+psycopg://USER:PASSWORD@HOST:5432/cloudmind
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEMO_ENABLED=true
RETENTION_DAYS=30
METRICS_SCRAPE_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
KAFKA_BOOTSTRAP_SERVERS=

# Advanced models persist outside the application directory.
MODEL_STORE=./model-artifacts
REDIS_URL=
AUTH_RATE_LIMIT=30
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
ARCHIVE_BUCKET=
DYNAMODB_EVENTS_TABLE=
OPENSEARCH_URL=
KAFKA_IAM=false
OTEL_ENDPOINT=
